<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Reboot.Titulo" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/reboot_texto_principal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Reboot.Cuerpo" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/reboot_texto_secundario</item>
    </style>

    <style name="TextAppearance.Reboot.Precio" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/reboot_texto_principal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Reboot.Enlace" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/reboot_enlace</item>
    </style>

    <style name="Widget.Reboot.Boton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/reboot_acento</item>
        <item name="android:textColor">@color/reboot_texto_sobre_acento</item>
    </style>

    <style name="AccesoPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Reboot.Cuerpo</item>
    </style>

    <!-- Estilo base para TextInputLayout OutlinedBox -->
    <style name="Widget.Reboot.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/stroke_campo</item>
        <item name="boxStrokeErrorColor">@color/reboot_error</item>
        <item name="hintTextColor">@color/hint_campo</item>
        <item name="android:textColorHint">@color/reboot_texto_secundario</item>
        <item name="boxBackgroundColor">@color/reboot_fondo</item>
        <item name="errorTextColor">@color/reboot_error</item>
        <item name="errorIconTint">@color/reboot_error</item>
        <item name="startIconTint">@color/icono_campo</item>
    </style>

    <style name="Widget.Reboot.TextInputLayout" parent="Widget.Reboot.TextInputLayout.OutlinedBox" />

    <!-- Estilo para Dropdowns ExposedDropdownMenu -->
    <style name="Widget.Reboot.TextInputLayout.OutlinedBox.ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/stroke_campo</item>
        <item name="boxStrokeErrorColor">@color/reboot_error</item>
        <item name="hintTextColor">@color/hint_campo</item>
        <item name="android:textColorHint">@color/reboot_texto_secundario</item>
        <item name="boxBackgroundColor">@color/reboot_fondo</item>
        <item name="errorTextColor">@color/reboot_error</item>
        <item name="errorIconTint">@color/reboot_error</item>
        <item name="endIconTint">@color/stroke_campo</item>
    </style>

    <!-- Estilo para EditText con mayor padding vertical (16dp) -->
    <style name="Widget.Reboot.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Estilo global para Toolbar de la aplicación -->
    <style name="Widget.Reboot.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/reboot_header</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>
</resources>
