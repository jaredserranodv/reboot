<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reboot_fondo">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/iconoFotoPerfil"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:background="@color/reboot_tarjeta"
            android:contentDescription="@null"
            android:padding="24dp"
            android:src="@drawable/ic_person"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/reboot_texto_secundario" />

        <!-- TODO: definir mecanismo real de captura/almacenamiento de foto de perfil -->
        <ImageView
            android:id="@+id/iconoCamara"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ic_launcher_background"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_edit"
            app:layout_constraintBottom_toBottomOf="@id/iconoFotoPerfil"
            app:layout_constraintEnd_toEndOf="@id/iconoFotoPerfil"
            app:tint="@color/white" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contenedorNombre"
            style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/editar_perfil_campo_nombre"
            app:startIconDrawable="@drawable/ic_person"
            app:layout_constraintTop_toBottomOf="@id/iconoFotoPerfil">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contenedorCorreo"
            style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/registro_correo"
            app:startIconDrawable="@drawable/ic_email"
            app:layout_constraintTop_toBottomOf="@id/contenedorNombre">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:cursorVisible="false"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contenedorTelefono"
            style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/editar_perfil_campo_telefono"
            app:startIconDrawable="@drawable/ic_phone"
            app:layout_constraintTop_toBottomOf="@id/contenedorCorreo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@+id/indicadorCarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contenedorTelefono" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGuardar"
            style="@style/Widget.Reboot.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/editar_perfil_boton_guardar"
            app:layout_constraintTop_toBottomOf="@id/indicadorCarga" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
