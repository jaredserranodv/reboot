<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reboot_fondo">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tituloRecuperar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recuperar_titulo"
            android:textAppearance="@style/TextAppearance.Reboot.Titulo"
            android:textSize="22sp"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Paso 1 -->
        <TextView
            android:id="@+id/tituloPaso1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/recuperar_paso1_titulo"
            android:textAppearance="@style/TextAppearance.Reboot.Titulo"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tituloRecuperar" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contenedorCorreo"
            style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/login_correo"
            app:startIconDrawable="@drawable/ic_email"
            app:layout_constraintTop_toBottomOf="@id/tituloPaso1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEnviarCodigo"
            style="@style/Widget.Reboot.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recuperar_boton_enviar_codigo"
            app:layout_constraintTop_toBottomOf="@id/contenedorCorreo" />

        <!-- Paso 2 -->
        <LinearLayout
            android:id="@+id/contenedorPaso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/botonEnviarCodigo">

            <TextView
                android:id="@+id/tituloPaso2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recuperar_paso2_titulo"
                android:textAppearance="@style/TextAppearance.Reboot.Titulo"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/preguntaSeguridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Reboot.Cuerpo"
                tools:text="¿Cual es el nombre de tu primera mascota?" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorRespuesta"
                style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/recuperar_campo_respuesta"
                app:startIconDrawable="@drawable/ic_security">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoRespuesta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorCodigo"
                style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/recuperar_campo_codigo"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonVerificar"
                style="@style/Widget.Reboot.Boton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/recuperar_boton_verificar" />
        </LinearLayout>

        <!-- Paso 3 -->
        <LinearLayout
            android:id="@+id/contenedorPaso3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/contenedorPaso2">

            <TextView
                android:id="@+id/tituloPaso3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recuperar_paso3_titulo"
                android:textAppearance="@style/TextAppearance.Reboot.Titulo"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorNuevaContrasena"
                style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/registro_contrasena"
                app:startIconDrawable="@drawable/ic_lock"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoNuevaContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorConfirmarContrasena"
                style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/registro_confirmar_contrasena"
                app:startIconDrawable="@drawable/ic_lock"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoConfirmarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonRestablecer"
                style="@style/Widget.Reboot.Boton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/recuperar_boton_restablecer" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
