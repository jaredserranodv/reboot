<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reboot_fondo">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Reboot.Toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:title="@string/metodos_pago_agregar_titulo"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/reboot_fondo"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorNumero"
                style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/metodos_pago_campo_numero"
                app:startIconDrawable="@drawable/ic_credit_card"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoNumero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="number"
                    android:maxLength="16" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorNombreTarjeta"
                style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/metodos_pago_campo_nombre_tarjeta"
                app:startIconDrawable="@drawable/ic_person"
                app:layout_constraintTop_toBottomOf="@id/contenedorNumero">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoNombreTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorVencimiento"
                style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/metodos_pago_campo_vencimiento"
                app:startIconDrawable="@drawable/ic_calendar"
                app:layout_constraintEnd_toStartOf="@id/contenedorCvv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/contenedorNombreTarjeta">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoVencimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="text"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorCvv"
                style="@style/Widget.Reboot.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:hint="@string/pago_cvv"
                app:startIconDrawable="@drawable/ic_lock"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/contenedorVencimiento"
                app:layout_constraintTop_toBottomOf="@id/contenedorNombreTarjeta">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoCvv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="numberPassword"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/casillaPredeterminado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/metodos_pago_campo_predeterminado"
                app:layout_constraintTop_toBottomOf="@id/contenedorVencimiento" />

            <ProgressBar
                android:id="@+id/indicadorCarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/casillaPredeterminado" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGuardar"
                style="@style/Widget.Reboot.Boton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/metodos_pago_boton_guardar"
                app:layout_constraintTop_toBottomOf="@id/indicadorCarga" />

            <TextView
                android:id="@+id/textoSimulacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/metodos_pago_footer_simulacion"
                android:textAppearance="@style/TextAppearance.Reboot.Cuerpo"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/botonGuardar" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
