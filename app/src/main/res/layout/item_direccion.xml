<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/reboot_fondo"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/etiquetaDireccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Reboot.Titulo"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/badgePredeterminada"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Casa" />

        <TextView
            android:id="@+id/badgePredeterminada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/reboot_tarjeta"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/direcciones_badge_predeterminada"
            android:textAppearance="@style/TextAppearance.Reboot.Cuerpo"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/direccionCompleta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Reboot.Cuerpo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etiquetaDireccion"
            tools:text="Av. Siempre Viva 123, Puebla" />

        <TextView
            android:id="@+id/telefonoDireccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Reboot.Cuerpo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/direccionCompleta"
            tools:text="2221234567" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEditar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/direcciones_boton_editar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/telefonoDireccion" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEliminar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/direcciones_boton_eliminar"
            app:layout_constraintStart_toEndOf="@id/botonEditar"
            app:layout_constraintTop_toBottomOf="@id/telefonoDireccion" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
